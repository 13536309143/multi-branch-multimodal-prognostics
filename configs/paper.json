{
  "data_root": "Multimodal data for prognostics",
  "artifact_root": "artifacts/paper",
  "results_root": "results/paper",
  "embedding_file": "assets/glove.6B.100d.subset.json",
  "seeds": [2021, 2022, 2023, 2024, 2025],
  "split_seed": 2021,
  "outer_grouping": "trajectory",
  "validation": "sample",
  "validation_fraction": 0.05,
  "blank_images": "preserve",
  "numeric_scaling": "standard",
  "target_scaling": "standard",
  "embedding_trainable": false,
  "text_dense_activation": "sigmoid",
  "batch_size": 64,
  "max_epochs": 500,
  "patience": 40,
  "min_delta": 0.00001,
  "optimizer": "adam",
  "learning_rate": 0.001,
  "weight_decay": 0.0,
  "num_workers": 0,
  "device": "auto",
  "deterministic": true,
  "ensemble_weighting": "inverse_mae",
  "baseline_selection": "paper_fixed",
  "svr_c": 100.0,
  "svr_gamma": "scale",
  "svr_epsilon": 0.1,
  "rf_estimators": 100,
  "models": ["itn", "in", "tn", "it", "i", "t", "n", "ensemble", "svr", "rf"]
}
